# Copy this file to ".env" and fill in your values, then run: npm run import
# (Only needed for the one-time import of existing products.)

# Your Sanity project id — from https://www.sanity.io/manage
SANITY_PROJECT_ID=

# Dataset name (leave as "production" unless you changed it)
SANITY_DATASET=production

# An API token with "Editor" access.
# Create one at: sanity.io/manage -> your project -> API -> Tokens -> Add API token
SANITY_TOKEN=
